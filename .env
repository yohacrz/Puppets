APP_NAME="PUPPETSS"
APP_ENV=local
APP_KEY=base64:MA5eFn014SpTCOKOt1P7MftcMdjUWOi91ivvMH3krNc=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Configuración de base de datos local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puppets
DB_USERNAME=root
DB_PASSWORD=Puppets@*2025

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuración de correo (no se usará para guardar en la BD)
